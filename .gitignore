# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example, ignore real envs)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sandbox / local artifacts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log
test
prompt
local-*
tool-results

# sqlite database — the panel db SHIPS with the repo (private repo doubles as
# the deployable data seed: schema + branded defaults + admin credentials).
# Only the transient sidecar files stay ignored.
/db/*.db-journal
/db/*.db-wal
/db/*.db-shm
/prisma/template.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# skill/tooling dirs (not part of the panel)
/skills/
/examples/
/mini-services/
/tests/

# user uploads / sandbox
/download/
/.zscripts/

# user chat uploads
/upload/
# local test copies — the Dockerfile downloads xray at build time
/bin/
.railway/
