# ─── Odyssey Panel ────────────────────────────────────────────────
# Copy this file to `.env` and adjust if needed.
# On Railway you can set these in the service Variables instead.

# SQLite database location (Railway: keep it on the mounted volume)
DATABASE_URL=file:/data/panel.db

# Optional: pin the public URL used in subscription links / QR codes.
# Leave empty to auto-detect from the browser you manage the panel with.
PANEL_PUBLIC_URL=

# Server port (Railway injects PORT automatically)
PORT=8080
